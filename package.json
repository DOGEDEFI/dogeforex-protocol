{
  "name": "imf-protocol",
  "version": "2.0.0",
  "description": "Independent currency systems extending Frankencoin mechanics to DogeOS.",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "size": "hardhat size-contracts",
    "deploy:local": "hardhat deploy --tags 00_deploy_all --network hardhat",
    "estimate:v2:usd": "node scripts/execution/v2_deploy_usd.mjs --estimate",
    "deploy:v2:preflight": "node scripts/execution/v2_deploy_usd.mjs --preflight",
    "deploy:v2:usd": "node scripts/execution/v2_deploy_usd.mjs --deploy",
    "verify:v2:usd": "node scripts/execution/v2_deploy_usd.mjs --verify",
    "reconcile:v1:rehearsals": "node scripts/execution/reconcile_rehearsals.mjs",
    "deploy:network": "npx hardhat deploy --network",
    "deploynotesttoken:network": "export deploymode=base && export deploymode=base && npx hardhat deploy --network",
    "redeploynotesttoken:network": "export deployoption=notesttoken && export deploymode=base && npx hardhat deploy --reset --network",
    "redeploy:network": "npx hardhat deploy --reset --network",
    "deployPositions:network": "export deploymode=pos && npx hardhat deploy --network"
  },
  "repository": {
    "type": "git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.9",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.1",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.6",
    "@types/mocha": "^10.0.1",
    "chai": "^4.3.8",
    "dotenv": "^16.3.1",
    "ethers": "^6.7.1",
    "hardhat-deploy": "^0.11.37",
    "hardhat-gas-reporter": "^1.0.9",
    "mocha": "^10.2.0",
    "solidity-coverage": "^0.8.4"
  },
  "dependencies": {
    "@typechain/ethers-v6": "^0.5.0",
    "hardhat": "^2.17.3",
    "hardhat-abi-exporter": "^2.10.0",
    "hardhat-contract-sizer": "^2.5.1",
    "prompt": "^1.3.0",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.1",
    "typescript": "^5.2.2"
  }
}
